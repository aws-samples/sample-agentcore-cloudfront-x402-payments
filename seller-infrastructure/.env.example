# Payment Configuration
# Wallet address on Base Sepolia to receive payments.
# If not set, falls back to the default address in lib/cloudfront-stack.ts.
# Network (Base Sepolia) and the base price are now configured at the WAF WebACL
# level (see lib/waf/monetization-config.ts); this var is only the payee wallet.
PAYMENT_RECIPIENT_ADDRESS=your_wallet_address
